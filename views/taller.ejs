<%- include("partials/header", { titulo }) %>

<% if (inscripcionOk) { %>
  <p class="ok">✅ Inscripción realizada correctamente.</p>
<% } %>

<article class="taller">
  <h2><%= taller.titulo %></h2>
  <p>Categoría: <%= taller.categoria %></p>
  <p>Nivel: <%= taller.nivel %></p>
  <p>Plazas totales: <%= taller.plazas %></p>

  <% if (estado === "completo") { %>
    <p>🔴 Completo</p>
  <% } else if (estado === "ultima") { %>
    <p>🟡 Última plaza disponible</p>
  <% } else { %>
    <p>🟢 <%= plazasRestantes %> plazas disponibles</p>
  <% } %>

  <a href="/talleres/<%= taller.id %>/inscripcion">Inscribirme</a>
</article>

<p><a href="/talleres">← Volver al listado</a></p>

<%- include("partials/footer") %>